# MongoDB Connection URI (Required)
MONGO_URI=mongodb://...

# Backend Port (Default 5000)
PORT=5000

# ==========================================
# ✉️ EMAIL SERVICE CONFIGURATION (Nodemailer)
# ==========================================
# Option 1: Custom SMTP (Recommended for Colleges)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_college_email@vignan.ac.in
SMTP_PASS=your_app_password
EMAIL_FROM="Vignan University Registrar <noreply@vignan.ac.in>"

# Option 2: Direct Gmail
# GMAIL_USER=your_account@gmail.com
# GMAIL_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx

# ==========================================
# 📱 SMS GATEWAY CONFIGURATION
# ==========================================
# Option 1: Twilio SMS Gateway
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=your_twilio_auth_token
# TWILIO_PHONE_NUMBER=+1234567890

# Option 2: Fast2SMS (India)
# FAST2SMS_API_KEY=your_fast2sms_api_key_here

